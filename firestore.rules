rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile document
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      // Subcollection: Game progress & DDA state
      match /game_progress/{progressId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Subcollection: Journey entries (moments, reflections, practices)
      match /journey_entries/{entryId} {
        allow read: if request.auth != null && (
          request.auth.uid == userId ||
          resource.data.visibility == 'School' ||
          resource.data.visibility == 'Dossier' ||
          resource.data.visibility == 'CEQHS Review' ||
          resource.data.includedInDossier == true
        );
        allow create, update, delete: if request.auth != null && request.auth.uid == userId;
      }

      // Subcollection: Personal development goals
      match /development_goals/{goalId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
